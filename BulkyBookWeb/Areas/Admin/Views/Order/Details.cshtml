@using BulkyBook.Models
@model OrderHeader
<div class="container-fluid py-3">
    <form method="post" enctype="multipart/form-data">
        @* TODO: Add hidden input for order ID *@
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="OrderDate" />
        <input type="hidden" asp-for="ApplicationUserId" />
        <input type="hidden" asp-for="ShippingDate" />
        @* TODO: Add back to orders link *@
        <a href="#" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
            <i class="bi bi-arrow-left"></i> Back to orders
        </a>

        <div class="card border shadow-sm overflow-hidden">
            <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-receipt me-2"></i>Order #<span>@Model.Id</span>
                    @* TODO: Display order ID *@
                </h5>
                <p class="mb-0 small" style="color: #1DB954;">Placed on <span>@Model.OrderDate.ToString("MM/dd/yyyy")</span></p>
                @* TODO: Display order date *@
            </div>

            <div class="card-body p-4">
                <div class="row g-5">
                    <!-- Left column: Shipping info -->
                    <div class="col-lg-6">
                        <h6 class="text-uppercase fw-semibold text-secondary mb-4" style="font-size: 0.7rem; letter-spacing: 0.1em;">
                            Shipping &amp; Tracking
                        </h6>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Name</label>
                            <div class="col-8">
                                @* TODO: Bind to Name property, make editable for admin, readonly for customer *@
                                <input type="text" asp-for="Name" class="form-control form-control-sm" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Phone</label>
                            <div class="col-8">
                                @* TODO: Bind to Phone property *@
                                <input type="text" asp-for="PhoneNumber" class="form-control form-control-sm" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Address</label>
                            <div class="col-8">
                                @* TODO: Bind to Address property *@
                                <input type="text" asp-for="StreetAddress" class="form-control form-control-sm" />
                                <span asp-validation-for="StreetAddress" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">City</label>
                            <div class="col-8">
                                @* TODO: Bind to City property *@
                                <input type="text" asp-for="City" class="form-control form-control-sm" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">State</label>
                            <div class="col-8">
                                @* TODO: Bind to State property *@
                                <input type="text" asp-for="State" class="form-control form-control-sm" />
                                <span asp-validation-for="State" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Zip Code</label>
                            <div class="col-8">
                                @* TODO: Bind to PostalCode property *@
                                <input type="text" asp-for="PostalCode" class="form-control form-control-sm" />
                                <span asp-validation-for="PostalCode" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Email</label>
                            <div class="col-8">
                                @* TODO: Display user email (read-only) *@
                                <input type="email" asp-for="ApplicationUser.Email" readonly class="form-control-plaintext form-control-sm" value="@Model.ApplicationUser.Email" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Order Date</label>
                            <div class="col-8">
                                @* TODO: Display order date (read-only) *@
                                <input type="text" readonly asp-for="OrderDate" class="form-control-plaintext form-control-sm" value="@Model.OrderDate" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Carrier</label>
                            <div class="col-8">
                                @* TODO: Bind to Carrier property *@
                                <input type="text" asp-for="Carrier" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Tracking</label>
                            <div class="col-8">
                                @* TODO: Bind to TrackingNumber property *@
                                <input type="text" asp-for="TrackingNumber" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Shipping Date</label>
                            <div class="col-8">
                                @* TODO: Display shipping date (read-only) *@
                                <input type="text" readonly class="form-control-plaintext form-control-sm" value="01/16/2024" />
                            </div>
                        </div>


                        <button type="submit" class="btn btn-accent w-100 fw-semibold mt-3">
                            Update Order Details
                        </button>
                    </div>

                    <!-- Right column: Order summary -->
                    <div class="col-lg-6">
                        <h6 class="text-uppercase fw-semibold text-secondary mb-4" style="font-size: 0.7rem; letter-spacing: 0.1em;">
                            Order Summary
                        </h6>

                        <span class="badge bg-dark mb-3">
                            <i class="bi bi-info-circle me-1" asp-for="OrderStatus"></i> <span>@Model.OrderStatus</span>
                            @* TODO: Display order status *@
                        </span>

                        <div class="border rounded overflow-hidden mb-4">
                            @* TODO: Loop through order items *@
                            @foreach (var product in Model.OrderDetails)
                                {
                                    <!-- Sample order item -->
                                    <div class="d-flex justify-content-between align-items-start p-3 border-bottom">
                                        <div>
                                            <p asp-validation-for="OrderHeader.OrderDetails" class="fw-medium small mb-0">@product.Product.Title</p>
                                            @* TODO: Display product title *@
                                            <p asp-validation-for="OrderHeader.OrderDetails" class="text-secondary mb-0" style="font-size: 0.75rem;">
                                                @product.Price.ToString("C") x @product.Count
                                                @* TODO: Display price and quantity *@
                                            </p>
                                        </div>

                                        <p asp-validation-for="OrderHeader.OrderDetails" class="fw-semibold small mb-0" style="color: #17A34A;">
                                        @((product.Price * product.Count).ToString("C"))    
                                            @* TODO: Display line total *@
                                        </p>
                                    </div>
                                }
                                <div class="d-flex justify-content-between align-items-center p-3 text-white" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
                                <span class="fw-bold small text-uppercase">Total</span>
                                <span asp-validation-for="OrderTotal" asp-for="OrderTotal" class="fw-bold fs-5">@Model.OrderTotal.ToString("C")</span>
                                @* TODO: Display order total *@
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-accent fw-semibold">
                                Start Processing
                            </button>

                            <button type="submit" onclick="return validateInput()" class="btn btn-accent fw-semibold">
                                Ship Order
                            </button>

                            <button type="submit" class="btn btn-danger fw-semibold">
                                Cancel Order
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
