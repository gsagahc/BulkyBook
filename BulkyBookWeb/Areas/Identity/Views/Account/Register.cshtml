@using BulkyBook.Utility
@model RegisterVM

<div class="container">
    <div class="row justify-content-center mt-5 mb-5">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border overflow-hidden">
                <div class="card-header text-white py-3 px-4 text-center" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
                    <i class="bi bi-person-plus-fill display-4"></i>
                    <h4 class="fw-bold mt-2 mb-1">Create Account</h4>
                    <p class="mb-0 small" style="color: #1DB954;">Join us today</p>
                </div>

                <div class="card-body p-5">
                    <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label"></label>
                                <input type="text" class="form-control form-control-lg" placeholder="John Doe" asp-for="Name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                              
                                <label asp-for="Email" class="form-label"></label>
                                <input type="email" class="form-control form-control-lg" placeholder="name@example.com" asp-for="Email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                               
                                <label asp-for="Password" class="form-label"></label>
                                <input type="password" class="form-control form-control-lg" placeholder="••••••••" asp-for="Password" />
                                <span asp-validation-for="Password" class="text-danger"></span>     
                            </div>

                            <div class="col-md-6 mb-3">
                              
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input type="password" class="form-control form-control-lg" placeholder="••••••••" asp-for="ConfirmPassword" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                          
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input type="text" class="form-control" placeholder="(123) 456-7890" asp-for="PhoneNumber" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                         
                            <label asp-for="StreetAddress" class="form-label"></label>
                            <input type="text" class="form-control" placeholder="123 Main St" asp-for="StreetAddress" />
                            <span asp-validation-for="StreetAddress" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-5 mb-3">
                               
                                <label asp-for="City" class="form-label"></label>
                                <input type="text" class="form-control" placeholder="New York" asp-for="City" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                            <div class="col-md-5 mb-3">

                                <label asp-for="Country" class="form-label fw-semibold small"></label>
                                <select asp-for="Country" asp-items="ViewBag.Paises" class="form-select">
                                    <option disabled selected>--Select Country--</option>
                                </select>
                               
                            </div>
                            <div class="col-md-4 mb-3">
                               
                                <label asp-for="State" class="form-label"></label>
                                <input type="text" class="form-control" placeholder="NY" asp-for="State" />
                                <span asp-validation-for="State" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                              
                                <label asp-for="PostalCode" class="form-label"></label>
                                <input type="text" class="form-control" placeholder="10001" asp-for="PostalCode" />
                                <span asp-validation-for="PostalCode" class="text-danger"></span>
                            </div>
                            <div class="col-md-5 mb-3">

                                <label asp-for="Role" class="form-label fw-semibold small"></label>
                                <select asp-for="Role"  asp-items=@Model.RoleList" class="form-select">
                                    <option disabled selected>--Select Role--</option>
                                </select>

                            </div>
                        </div>

                        <button type="submit" class="btn btn-accent btn-lg w-100 mb-3">
                            <a asp-controller="Account" asp-action="Register" class="btn btn-light fw-medium">Cancel</a>
                            <i class="bi bi-person-check me-2"></i>Register
                        </button>
                    </form>

                    <hr class="my-4" />

                    <div class="text-center">
                        
                        <p class="mb-0">Already have an account? <a asp-area="Identity" asp-controller="account" 
                            asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]"
                            class="fw-semibold text-decoration-none" style="color: #17A34A;">Log in</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
 
}